# Environment configuration
# Copy this to .env and fill in real values

# Database
POSTGRES_USER=mospi
POSTGRES_PASSWORD=mospipass
POSTGRES_DB=mospi_db

# JWT
SECRET_KEY=change-me-to-a-long-random-secret-key-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# LLM for MCQ generation (choose one)
# Option 1: OpenAI compatible
LLM_PROVIDER=openai
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o-mini

# Option 2: Ollama (local, no API key needed)
# LLM_PROVIDER=ollama
# OLLAMA_BASE_URL=http://host.docker.internal:11434
# OLLAMA_MODEL=llama3.2

# iGOT API (stub mode by default)
IGOT_API_BASE_URL=https://igot.gov.in/api  # not used in stub mode
IGOT_API_KEY=stub                           # set to 'stub' to use mock data

# Object storage (local disk for MVP)
STORAGE_BACKEND=local    # 'local' or 's3'
LOCAL_UPLOAD_DIR=/app/uploads

# S3 (only if STORAGE_BACKEND=s3)
# S3_BUCKET=mospi-uploads
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=ap-south-1
